# /extlinux/others.env -- read by U-Boot's preboot hook (others_next) on every
# boot. Lives on the ESP, next to extlinux.conf.
#
# Format: text env file (env import -t), '#' starts a comment.
# Only bootmenu_0..bootmenu_9, next_title and next_boot are imported:
#   bootmenu_N=<menu title>=<command>
#
# deliberately NO next_title / next_boot here. Those turn an entry into a
# one-shot default, and the original project expects the booted system to
# clear them via marble-oneshot-clear.service -- Debian does not ship that
# service, so Android would silently become the default on every boot.
#
# Commands that exist on marble:
#   run android_boot   -> LUN4 boot_a / vendor_boot_a / dtbo_a (Android)
#   run pmos_boot      -> esp:/extlinux/extlinux.conf (this Debian)

bootmenu_0=Android =run android_boot; pause
bootmenu_1=Debian =run pmos_boot; pause
